{
  "description": "F15 read-only operations dashboard. Synthetic data until real sources are approved.",
  "editable": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "1 when the responsible-use policy and the global stop allow recommendations. No sample counts as 0.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "min(tennis_recommendations_allowed) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Recommendations allowed",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "Prometheus alerts in the firing state.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Firing alerts",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "More than 300 s raises TennisSchedulerStale.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "time() - tennis_scheduler_last_tick_timestamp_seconds",
          "refId": "A"
        }
      ],
      "title": "Seconds since the last scheduler tick",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "Share of scrape targets that answered the last scrape.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "sum(up) / count(up)",
          "refId": "A"
        }
      ],
      "title": "Scrape targets up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "Every firing alert with its rule, reason, control and scope.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Firing alerts",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "The scheduler's own rule evaluation. It applies the stops.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "tennis_deterministic_alert",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Deterministic alerts (scheduler)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "Latest value of each measured signal. A missing signal has no row.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 7,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "tennis_signal_value",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Signal values",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "F14 source-health status per source.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 8,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "tennis_source_status == 1",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Source status",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "Age of the latest quote observation per source.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 9,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "tennis_source_observation_age_seconds",
          "legendFormat": "{{source_id}}",
          "refId": "A"
        }
      ],
      "title": "Quote observation age",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "Scheduler job outcomes by state.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "id": 10,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "sum by (state) (increase(tennis_job_outcomes_total[15m]))",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "title": "Job outcomes (15 min)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "Age of the newest backup of each store. Objects and journal must stay below the RPO of 15 minutes; the base backup below 26 hours.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "id": 11,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "time() - tennis_backup_last_success_timestamp_seconds",
          "legendFormat": "{{store}}",
          "refId": "A"
        }
      ],
      "title": "Recovery point age",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "Archived and failed WAL segments. A failed segment puts the RPO at risk.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "id": 12,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "tennis_wal_archive_segments",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "title": "WAL segments (pg_stat_archiver)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "tennis-prometheus"
      },
      "description": "API requests per second by route template and status.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "id": 13,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "tennis-prometheus"
          },
          "expr": "sum by (route, status) (rate(tennis_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP requests",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "tennis",
    "f15"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "utc",
  "title": "Tennis operations",
  "uid": "tennis-operations",
  "version": 1
}
