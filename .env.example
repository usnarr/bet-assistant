# Copy to .env for local Compose use. Never commit real credentials.
TENNIS_ENVIRONMENT=development
TENNIS_DATABASE_URL=postgresql+psycopg://tennis:local-only@postgres:5432/tennis
TENNIS_OBJECT_STORE_ENDPOINT=object-store:9000
TENNIS_OBJECT_STORE_ACCESS_KEY=local-development
TENNIS_OBJECT_STORE_SECRET_KEY=change-me-before-use
TENNIS_OBJECT_STORE_BUCKET=tennis-raw
TENNIS_OBJECT_STORE_SECURE=false
TENNIS_ARTIFACT_ROOT=/app/var/artifacts
TENNIS_LOG_LEVEL=INFO
TENNIS_WORKER_POLL_SECONDS=5
# F14 serving. Compose sets the file paths inside the containers.
TENNIS_SERVING_ENABLED=true
TENNIS_SERVING_ACCOUNT_SCOPE=shadow
TENNIS_SERVING_STALE_AFTER_SECONDS=300
# Optional read-only database role for the API (see docs/operations/README.md).
# TENNIS_SERVING_DATABASE_URL=postgresql+psycopg://tennis_reader:<password>@postgres:5432/tennis

POSTGRES_DB=tennis
POSTGRES_USER=tennis
POSTGRES_PASSWORD=local-only
